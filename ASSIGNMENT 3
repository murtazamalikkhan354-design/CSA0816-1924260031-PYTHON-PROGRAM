# Benchmark dictionary merging
def generate_contacts(n):
    return [{"name": "Person " + str(i),
             "phone": "900" + str(i).zfill(10),
             "email": "person" + str(i) + "@mail.com"}
            for i in range(n)]
 
print("\nTIMING EXPERIMENT (seconds)")
for n in [1000, 100000]:
    data = generate_contacts(n)
    start = time.perf_counter()
    merged = merge_contacts(data)
    elapsed = time.perf_counter() - start
    print(n, "contacts:", round(elapsed, 5),
          "seconds; output groups:", len(merged))
 
