import time
 
def normalize_phone(phone):
    if not phone:
        return ""
    phone = "".join(ch for ch in str(phone) if ch.isdigit())
    if len(phone) == 12 and phone.startswith("91"):
        phone = phone[2:]
    if len(phone) == 11 and phone.startswith("0"):
        phone = phone[1:]
    return phone
 
def normalize_name(name):
    return " ".join(str(name or "").lower().split())
 
def merge_contacts(contacts):
    groups = {}
    phone_index = {}
    email_index = {}
 
    for i, contact in enumerate(contacts):
        name = normalize_name(contact.get("name", ""))
        phone = normalize_phone(contact.get("phone", ""))
        email = str(contact.get("email") or "").strip().lower()
 
        matches = set()
        if phone and phone in phone_index:
            matches.add(phone_index[phone])
        if email and email in email_index:
            matches.add(email_index[email])
 
        if not matches:
            group_id = i
            groups[group_id] = {
                "names": set(), "phones": set(), "emails": set()
            }
        else:
            group_id = min(matches)
            for old_id in matches:
                if old_id != group_id:
                    groups[group_id]["names"].update(groups[old_id]["names"])
                    groups[group_id]["phones"].update(groups[old_id]["phones"])
                    groups[group_id]["emails"].update(groups[old_id]["emails"])
                    del groups[old_id]
 
        if name:
            groups[group_id]["names"].add(name)
        if phone:
            groups[group_id]["phones"].add(phone)
            phone_index[phone] = group_id
        if email:
            groups[group_id]["emails"].add(email)
            email_index[email] = group_id
 
        for p in groups[group_id]["phones"]:
            phone_index[p] = group_id
        for e in groups[group_id]["emails"]:
            email_index[e] = group_id
 
    return list(groups.values())
 
